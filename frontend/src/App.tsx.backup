function StatCard({
  icon: Icon,
  color,
  label,
  value,
  change,
}: {
  icon: typeof Leaf;
  color: string;
  label: string;
  value: string;
  change: string;
}) {
  return (
    <article className="stat-card">
      <div className="stat-top">
        <span>{label}</span>
        <div className={`stat-icon ${color}`}><Icon size={19} /></div>
      </div>
      <strong className="stat-value">{value}</strong>
      <span className="stat-caption">{change}</span>
    </article>
  );
}

function ActionCard({
  icon: Icon,
  title,
  description,
  color,
  onClick,
}: {
  icon: typeof Leaf;
  title: string;
  description: string;
  color: string;
  onClick: () => void;
}) {
  return (
    <button className="action-card" onClick={onClick}>
      <span className={`action-icon ${color}`}><Icon size={20} /></span>
      <span className="action-copy">
        <strong>{title}</strong>
        <span>{description}</span>
      </span>
      <ChevronRight size={17} className="action-chevron" />
    </button>
  );
}

function ScanWaste() {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState("");
  const [message, setMessage] = useState("");

  function handleFile(event: ChangeEvent<HTMLInputElement>) {
    const selected = event.target.files?.[0];

    if (!selected) return;

    if (!selected.type.startsWith("image/")) {
      setMessage("Please select an image file.");
      return;
    }

    if (selected.size > 5 * 1024 * 1024) {
      setMessage("Choose an image smaller than 5 MB.");
      return;
    }

    if (preview) URL.revokeObjectURL(preview);

    setFile(selected);
    setPreview(URL.createObjectURL(selected));
    setMessage(
      "Image selected. AI analysis will be enabled after the backend is connected."
    );
  }

  return (
    <section className="feature-page">
      <div className="eyebrow"><Sparkles size={14} /> WASTE INTELLIGENCE</div>
      <h1>Give your waste a second chance.</h1>
      <p className="page-description">
        Upload an image of an item to prepare it for analysis and discover
        responsible next steps.
      </p>

      <div className="panel upload-panel">
        <label className="upload-zone">
          {preview ? (
            <img className="image-preview" src={preview} alt="Selected waste item" />
          ) : (
            <>
              <div className="upload-icon"><Upload size={27} /></div>
              <strong>Drop an image here or browse files</strong>
              <span>PNG, JPG or WEBP · Maximum 5 MB</span>
            </>
          )}
          <input type="file" accept="image/png,image/jpeg,image/webp" onChange={handleFile} />
        </label>

        {file && <p className="selected-file">{file.name}</p>}
        {message && <div className="inline-message">{message}</div>}

        <button
          className="primary-button full-button"
          disabled={!file}
          onClick={() =>
            setMessage(
              "Ready for the next step: connect this form to the new AWS API."
            )
          }
        >
          <Sparkles size={17} /> Prepare waste analysis
        </button>
      </div>

      <div className="info-grid">
        <InfoCard icon={Sprout} title="Reuse first" text="Discover practical ways to extend an item's useful life." />
        <InfoCard icon={Recycle} title="Recycle responsibly" text="Identify the right disposal route for each material." />
        <InfoCard icon={ShieldCheck} title="Safety matters" text="Follow material-specific handling and recycling guidance." />
      </div>
    </section>
  );
}

function InfoCard({
  icon: Icon,
  title,
  text,
}: {
  icon: typeof Leaf;
  title: string;
  text: string;
}) {
  return (
    <article className="panel info-card">
      <Icon size={22} className="green-icon" />
      <strong>{title}</strong>
      <p>{text}</p>
    </article>
  );
}

function AIAssistant() {
  const [input, setInput] = useState("");
  const [sent, setSent] = useState<string[]>([]);

  function sendMessage() {
    const text = input.trim();
    if (!text) return;

    setSent((current) => [...current, text]);
    setInput("");
  }

  return (
    <section className="feature-page">
      <div className="eyebrow"><Sparkles size={14} /> ECOLOOP ASSISTANT</div>
      <h1>Let's rethink waste.</h1>
      <p className="page-description">
        Explore ideas for reuse, recycling, creative projects and responsible
        waste management.
      </p>

      <div className="panel chat-panel">
        <div className="chat-heading">
          <div className="assistant-avatar"><Bot size={24} /></div>
          <div>
            <strong>EcoLoop AI</strong>
            <span>Waste and circular-economy assistant</span>
          </div>
          <span className="demo-status">Preview</span>
        </div>

        <div className="chat-messages">
          <div className="chat-bubble assistant-bubble">
            Vanakkam! 🌱 What kind of waste are you dealing with? Tell me
            about it, and we can explore ways to reduce, reuse, recycle or
            transform it into something useful.
          </div>

          {sent.map((text, index) => (
            <div className="chat-bubble user-bubble" key={`${text}-${index}`}>
              {text}
            </div>
          ))}
        </div>

        <div className="suggestion-list">
          {[
            "What can I create from plastic bottles?",
            "How do I recycle old electronics?",
            "How can kitchen waste become useful?",
          ].map((suggestion) => (
            <button key={suggestion} onClick={() => setInput(suggestion)}>
              {suggestion} <ArrowUpRight size={14} />
            </button>
          ))}
        </div>

        <form
          className="chat-input-row"
          onSubmit={(event) => {
            event.preventDefault();
            sendMessage();
          }}
        >
          <input
            value={input}
            onChange={(event) => setInput(event.target.value)}
            placeholder="Ask about any waste item..."
            aria-label="Your question"
          />
          <button className="primary-button send-button" type="submit" aria-label="Send message">
            <Send size={17} />
          </button>
        </form>
        <p className="chat-disclaimer">
          Interface preview only. AI responses will work after backend integration.
        </p>
      </div>
    </section>
  );
}

function RecyclingFinder() {
  return (
    <section className="feature-page">
      <div className="eyebrow"><Recycle size={14} /> CIRCULAR ECONOMY</div>
      <h1>Give materials another life.</h1>
      <p className="page-description">
        Learn how different materials can be recovered, reused or recycled.
      </p>

      <div className="finder-grid">
        {[
          { name: "Plastic bottles", type: "PET plastic", icon: Recycle, color: "mint", details: "Check the resin code and local acceptance rules." },
          { name: "Paper & cardboard", type: "Paper products", icon: FileImage, color: "yellow", details: "Keep recyclable paper dry and free from food contamination." },
          { name: "Electronic waste", type: "E-waste", icon: Zap, color: "purple", details: "Use authorized e-waste collection and recycling channels." },
          { name: "Organic waste", type: "Biodegradable", icon: Sprout, color: "blue", details: "Explore suitable composting or local biogas programs." },
        ].map((item) => {
          const Icon = item.icon;

          return (
            <article className="panel material-card" key={item.name}>
              <div className={`material-icon ${item.color}`}><Icon size={25} /></div>
              <span className="material-type">{item.type}</span>
              <h3>{item.name}</h3>
              <p>{item.details}</p>
              <span className="listing-note">General guidance · Check locally</span>
            </article>
          );
        })}
      </div>

      <div className="panel notice-panel">
        <CircleHelp size={21} />
        <div>
          <strong>Looking for local recyclers?</strong>
          <p>
            Live collection locations and current buying prices will be
            added after verified recycler data is connected.
          </p>
        </div>
      </div>
    </section>
  );
}

function MyImpact() {
