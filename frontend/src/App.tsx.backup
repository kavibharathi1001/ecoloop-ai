        <div className="ledger-summary">
          <div><span>Reported</span><strong>2.05 kg</strong></div>
          <div><span>Verified recovered</span><strong>0.05 kg</strong></div>
          <div><span>Awaiting collection</span><strong>0.80 kg</strong></div>
        </div>

        <div className="ledger-note">
          <CheckCircle2 size={18} />
          Only verified collection records count toward verified recovery.
